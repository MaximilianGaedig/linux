/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "mt8163-amazon-common.dtsi"
#include "mt8163-headless.dtsi"

/ {
	model = "Amazon Echo Dot (2016)";
	compatible = "amazon,biscuit", "mediatek,mt8163";
	chassis-type = "embedded";

	/* Needed by stock bootloader */
	version = "evt";

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&gpio_keys_pins_default>;

		key-volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pio 50 GPIO_ACTIVE_LOW>;
			debounce-interval = <20>;
		};

		/*
		 * Stock biscuit.dtsi wires this as a plain gpio-keys button on
		 * GPIO37 (volumedn@114, gpios = <&pio 37 1>), NOT through the KPD
		 * matrix - our &keypad node below had pinmuxed this same pin to
		 * KPCOL1 and claimed it as a MATRIX_KEY, which is a real pinmux
		 * conflict with this node's plain-GPIO claim on the same pin.
		 * Moved here to match stock exactly; see keypad_pins_default.
		 */
		key-volume-down {
			label = "Volume Down";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&pio 37 GPIO_ACTIVE_LOW>;
			debounce-interval = <20>;
		};
	};
};

&keypad {
	/*
	 * KEY_VOLUMEDOWN removed - see key-volume-down in gpio-keys above.
	 * KEY_ASSISTANT is unverified: stock reads the Dot/Assistant button
	 * through Amazon's proprietary kpd.c hw-scan-code table
	 * (mediatek,kpd-hw-init-map = <138 ...>). Whether pin 36/KPCOL0 carries
	 * the same physical button wired to a plain matrix contact, or
	 * something else entirely, is unconfirmed - needs a press tested
	 * against evtest once evdev is enabled, not assumed.
	 */
	linux,keymap = <MATRIX_KEY(0x00, 0x00, KEY_ASSISTANT)>;

	keypad,num-rows = <1>;
	keypad,num-columns = <1>;
	debounce-delay-ms = <20>;

	pinctrl-names = "default";
	pinctrl-0 = <&keypad_pins_default>;

	status = "okay";
};

&mt6323keys {
	/*
	 * Stock has no separate power button - this board wires the PMIC's
	 * dedicated hardware PWRKEY comparator pin to the physical mute
	 * switch instead, and its own vendor kpd.c driver remaps that slot to
	 * KEY_MUTE (mediatek,kpd-sw-pwrkey = <113> in Amazon's biscuit.dtsi).
	 * Confirmed via the stock button_config.json used by their userspace
	 * buttond: "mute" is keyCode 113 (KEY_MUTE) EV_KEY, matching exactly.
	 * mtk-pmic-keys.c is mainline's driver for this same PMIC hardware -
	 * same physical pin/comparator/IRQ, just the standard upstream path
	 * instead of Amazon's vendor kpd.c. "home" (the PMIC's second,
	 * separate comparator pin) is left at its inherited default; nothing
	 * on this board is confirmed wired to it.
	 */
	power {
		linux,keycodes = <KEY_MUTE>;
	};
};

&mt6323_vusb_reg {
	regulator-always-on;
};

&watchdog {
	/*
	 * No bark interrupt. With it, mtk_wdt runs in dual (pretimeout) mode,
	 * where the first stage is half the timeout - exactly the interval
	 * systemd uses to ping (RuntimeWatchdogSec / 2). Pings then race the
	 * stage boundary, and the board reset every ~2 minutes of uptime.
	 */
	/delete-property/ interrupts;
};

&thermal {
	status = "disabled";
};

&u2phy0 {
	status = "okay";
};

&usb0 {
	/* No 5V supply for OTG support. */
	dr_mode = "peripheral";
	status = "okay";
};

&pio {
	gpio_keys_pins_default: gpio-keys-pins {
		pins {
			pinmux = <MT8163_PIN_50_EINT18__FUNC_GPIO50>,
				 <MT8163_PIN_37_KPCOL1__FUNC_GPIO37>;
			bias-pull-up;
			input-enable;
		};
	};

	keypad_pins_default: keypad-pins {
		pins {
			pinmux = <MT8163_PIN_36_KPCOL0__FUNC_KPCOL0>;
			input-enable;
		};
	};
};

/*
 * amazon-common.dtsi declares all 512MB (0x40000000 + 0x20000000), but the
 * top of that range is not ours: LK reports mblock[0] as 0x1f800000, the ATF
 * log buffer sits at 0x5f800000, and everything from 0x5fa00000 up is locked
 * by the EMI MPU - the kernel faults if it actually touches it.
 *
 * Override rather than add a second node: the kernel walks every node with
 * device_type = "memory" and adds them all to memblock, so a new one would
 * declare the same RAM twice and reintroduce the range we are trying to
 * exclude.
 */
&{/memory} {
	reg = <0 0x40000000 0 0x1f800000>;
};
