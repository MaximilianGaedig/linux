/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "mt8163-amazon-common.dtsi"
#include "mt8163-headless.dtsi"
#include "mt8163-amazon-biscuit-peripherals.dtsi"

/ {
	model = "Amazon Echo Dot (2016)";
	compatible = "amazon,biscuit", "mediatek,mt8163";
	chassis-type = "embedded";

	/* Needed by stock bootloader */
	version = "evt";


	/*
	 * External speaker amplifier enable. Amazon's stock audio driver
	 * asserts this by selecting the "extamp-pullhigh" pinctrl state
	 * (AudDrv_GPIO_EXTAMP_Select(1)), which drives GPIO 124 output-high;
	 * the "extamp-pulllow" state drives it low to mute. Mainline's mt8163
	 * pinctrl (pinctrl-mtk-common) does not implement PIN_CONFIG_OUTPUT, so
	 * an output-high pinctrl group would be silently ignored here - drive
	 * the same pin through a fixed regulator instead, which requests the
	 * GPIO after the gpiochip is up (a gpio-hog fails with -EPROBE_DEFER
	 * during gpiochip_add and takes the whole pinctrl driver down with it).
	 * Without this the aic32x4 codec plays but the amp stays muted, so
	 * nothing is audible.
	 */
	ext_spk_amp: regulator-ext-spk-amp {
		compatible = "regulator-fixed";
		regulator-name = "ext-spk-amp";
		gpio = <&pio 124 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&gpio_keys_pins_default>;

		key-volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pio 50 GPIO_ACTIVE_LOW>;
			debounce-interval = <20>;
		};
	};
};

&keypad {
	linux,keymap = <MATRIX_KEY(0x00, 0x00, KEY_ASSISTANT)
			MATRIX_KEY(0x00, 0x01, KEY_VOLUMEDOWN)>;

	keypad,num-rows = <1>;
	keypad,num-columns = <2>;
	debounce-delay-ms = <20>;

	pinctrl-names = "default";
	pinctrl-0 = <&keypad_pins_default>;

	status = "okay";
};

&mt6323_vusb_reg {
	regulator-always-on;
};

&thermal {
	status = "disabled";
};

&u2phy0 {
	status = "okay";
};

&usb0 {
	/* No 5V supply for OTG support. */
	dr_mode = "peripheral";
	status = "okay";
};

&pio {
	gpio_keys_pins_default: gpio-keys-pins {
		pins {
			pinmux = <MT8163_PIN_50_EINT18__FUNC_GPIO50>;
			bias-pull-up;
			input-enable;
		};
	};

	keypad_pins_default: keypad-pins {
		pins {
			pinmux = <MT8163_PIN_36_KPCOL0__FUNC_KPCOL0>,
				 <MT8163_PIN_37_KPCOL1__FUNC_KPCOL1>;
			input-enable;
		};
	};
};

/*
 * amazon-common.dtsi declares all 512MB (0x40000000 + 0x20000000), but the
 * top of that range is not ours: LK reports mblock[0] as 0x1f800000, the ATF
 * log buffer sits at 0x5f800000, and everything from 0x5fa00000 up is locked
 * by the EMI MPU - the kernel faults if it actually touches it.
 *
 * Override rather than add a second node: the kernel walks every node with
 * device_type = "memory" and adds them all to memblock, so a new one would
 * declare the same RAM twice and reintroduce the range we are trying to
 * exclude.
 */
&{/memory} {
	reg = <0 0x40000000 0 0x1f800000>;
};

/*
 * Keep the rails the stock kernel keeps.
 *
 * Nothing in this devicetree claims these as supplies yet, so
 * regulator_init_complete() switches them off as "unused" - the log line
 * "va: disabling / vgp2: disabling / vcamaf: disabling" is the kernel
 * cutting power to peripherals we are trying to talk to. Once that happens
 * the IS31FL3236 stops ACKing on i2c0 (write returns -ENXIO) and the
 * TLV320 codecs report invalid supply voltages.
 *
 * biscuit.dtsi in the FireOS 3.18 source marks all of these always-on, so
 * mirror it rather than guess which peripheral sits on which rail. These
 * can be narrowed later by giving each consumer a proper *-supply phandle.
 */
&mt6323_va_reg        { regulator-always-on; };
&mt6323_vgp1_reg      { regulator-always-on; };
&mt6323_vgp2_reg      { regulator-always-on; };
&mt6323_vcamaf_reg    { regulator-always-on; };
&mt6323_vmch_reg      { regulator-always-on; };
&mt6323_vemc3v3_reg   { regulator-always-on; };
&mt6323_vio18_reg     { regulator-always-on; };
&mt6323_vio28_reg     { regulator-always-on; };
&mt6323_vm_reg        { regulator-always-on; };
&mt6323_vmc_reg       { regulator-always-on; };
/*
 * MT6625L combo chip power rails - none of mt6323.dtsi's regulator nodes
 * for these are always-on, and nothing enables them until the WMT
 * userspace power-on ioctl runs, well after mmc1's own boot-time SDIO
 * probe has already given up on an unpowered chip. Force them up from
 * boot so the chip is actually alive by the time mmc core probes it.
 */
&mt6323_vcn18_reg     { regulator-always-on; };
&mt6323_vcn28_reg     { regulator-always-on; };
&mt6323_vcn33_bt_reg  { regulator-always-on; };
&mt6323_vcn33_wifi_reg { regulator-always-on; };

/*
 * MT6625L combo WiFi/BT/GPS. The CONSYS subsystem block is described in
 * mt8163.dtsi but left disabled there, since only boards that actually
 * populate the combo chip should probe it.
 */
&consys {
	/*
	 * Re-enabled: bisection showed the earlier hang persisted even with
	 * this node disabled, so it was never actually the cause - the real
	 * blocker was the missing btif/btif_tx/btif_rx nodes (see mt8163.dtsi).
	 *
	 * pinctrl-names/pinctrl-N are already set correctly by
	 * mt8163-amazon-common.dtsi (default/wifi_reset_init/
	 * consys_pins_default) - don't repeat them here, an override with a
	 * shorter pinctrl-names list would drop the "consys_pins_default"
	 * state mtk_wmt_probe() looks up by name.
	 */
	status = "okay";
};

/*
 * AFE (audio front end). Disabled by default in mt8163.dtsi since only
 * boards that actually populate audio codecs should probe it - biscuit has
 * a full mic array + speaker codec, so turn it on here.
 */
&afe {
	status = "okay";
	#sound-dai-cells = <1>;
};

/*
 * Sound card. MT8163 has no in-tree ASoC machine driver, so wire the AFE's
 * I2S CPU DAIs to codecs with the generic simple-audio-card binding instead
 * of writing one.
 *
 * Speaker: DL1 (front-end playback memif) -> AFE I2S0 backend -> aic32x4 on
 * i2c2. Confirmed against Amazon's own stock machine driver: their
 * "TI_DAC_Playback" dai_link uses cpu_dai_name = MT_SOC_DL1DAI_NAME, i.e.
 * the same DL1 front-end.
 *
 * Mic array: NOT wired through the AFE at all. Reverse-engineering Amazon's
 * stock dai_link table (mt_soc_machine.c) showed the real capture path is
 * "AMZN_SPI_Capture": cpu_dai_name = platform_name = AMZN_MT_SPI_PCM, a
 * fully custom driver (amzn-spi-pcm/) that bit-bangs a "dough" FPGA over
 * SPI. The four aic3x mic codecs output I2S into that FPGA - not into the
 * SoC - which mixes/packages all channels and hands finished frames back to
 * the SoC over SPI0. See mt8163-amazon-biscuit-peripherals.dtsi for the
 * FPGA node and drivers/spi mt8163-spi-fpga-pcm.c for the driver this
 * links against. mic0_codec (i2c0@0x18) is kept as the codec side purely
 * because Amazon's own link pairs it that way (codec_name =
 * "tlv320aic3101.0-0018") - it is presumably used for control/gain only,
 * since audio samples never actually cross I2C.
 */
/ {
	sound: sound {
		compatible = "amazon,biscuit-audio";
		mediatek,platform = <&afe>;
		/*
		 * MT8163's AFE splits playback into a front-end memif (DL1)
		 * and a separate I2S back-end DAI; only a DPCM card can bind
		 * them. simple-audio-card built a plain DL1<->codec link, which
		 * left the I2S port unconfigured so nothing was ever clocked
		 * out of the SoC pins and the speaker stayed silent.
		 *
		 * I2S DAIs here are unidirectional: I2S0/I2S2 capture,
		 * I2S1/I2S3 playback - so the speaker back-end is I2S1.
		 * Combined DAI indices: DL1=0 DL2=1 VUL=2 AWB=3
		 *                       I2S0=4 I2S1=5 I2S2=6 I2S3=7
		 */
		mediatek,fe-dai = <&afe 0>;    /* DL1 front-end memif */
		mediatek,be-dai = <&afe 5>;    /* I2S1 playback back-end */
		mediatek,audio-codec = <&aic32x4_codec>;
	};
};

/*
 * Mic-array FPGA. SPI0 is otherwise unused on this board.
 */
&spi {
	pinctrl-names = "default";
	pinctrl-0 = <&spi_pins_default>;
	status = "okay";

	spi_pcm_fpga: audio-fpga@0 {
		compatible = "amazon,biscuit-spi-pcm";
		reg = <0>;
		spi-max-frequency = <50000000>;
		#sound-dai-cells = <0>;

		reset-gpios = <&pio 43 GPIO_ACTIVE_LOW>;

		pinctrl-names = "idle", "active", "mclk";
		pinctrl-0 = <&aud_pins_i2s1_idle>;
		pinctrl-1 = <&aud_pins_i2s1_active>;
		pinctrl-2 = <&aud_pins_fpga_mclk>;

		/*
		 * FPGA reference clock = the CMMCLK pad, which on MT8163 is
		 * driven by the camera SENINF (sensor interface) timing
		 * generator, NOT by CAMTG_SEL alone. Matching Amazon's stock
		 * mt_amzn_mclk.c (GPL kernel source): the driver must power the
		 * ISP domain, enable the imgsys sensor clocks, set CAMTG_SEL to
		 * UNIVPLL_D26 (48 MHz), and program the SENINF TG1 divider to
		 * emit 9.6 MHz on the pad. Without the SENINF programming the
		 * FPGA gets no clock and reads back revision 0.
		 *
		 * mclk      = CAMTG_SEL (set to 48 MHz in the driver)
		 * sen_tg    = the SENINF timing generator that drives the pad
		 * sen_cam/larb2_smi/cam_smi = imgsys register-bus/sensor clocks
		 *             needed to reach the SENINF registers (ISP domain)
		 */
		clocks = <&topckgen CLK_TOP_CAMTG_SEL>,
			 <&imgsys CLK_IMG_SEN_TG>,
			 <&imgsys CLK_IMG_SEN_CAM>,
			 <&imgsys CLK_IMG_LARB2_SMI>,
			 <&imgsys CLK_IMG_CAM_SMI>;
		clock-names = "mclk", "sen_tg", "sen_cam", "larb2_smi", "cam_smi";
		power-domains = <&spm MT8163_POWER_DOMAIN_ISP>;
	};
};

/*
 * Firmware for the mic-array FPGA (bitstream/config, not a Linux driver
 * module). Amazon's biscuit_defconfig: CONFIG_EXTRA_FIRMWARE =
 * "i2s_to_spi_v34.bin". Not yet extracted from the stock Fire OS
 * partitions - request_firmware() will fail until
 * /lib/firmware/i2s_to_spi_v34.bin is populated on the target rootfs.
 */

/*
 * BTIF (HCI transport for the MT6625L combo chip). See the comment on the
 * node in mt8163.dtsi for why this specifically was blocking boot.
 */
&btif {
	status = "okay";
};

&btif_tx {
	status = "okay";
};
&btif_rx {
	status = "okay";
};

/*
 * wmt_gpio_init() (drivers/misc/mediatek/connectivity/common/common_detect/
 * wmt_gpio.c) looks this node up by of_find_compatible_node() - it is not a
 * bound device, just a property container the legacy WMT combo-chip power
 * sequencing code reads gpio_combo_*_pin properties from. Without it,
 * wmt_gpio_init() bails immediately ("can't find device tree node!") and
 * the MT6625L combo chip's power-on sequence never runs at all.
 *
 * Only rst/pmu_en are supplied: biscuit's WB_* pin group (wifi_reset_init
 * in mt8163-amazon-common.dtsi) breaks out exactly four pins - RSTB, SCLK,
 * SDATA, SEN - with SEN ("System ENable") mapping to PMU_EN and RSTB to
 * RST. There's no fifth pin for a WIFI_EINT gpio; wmt_detect_pwr.c's
 * precondition check was relaxed to not require one, consistent with this
 * being an SDIO combo chip that signals in-band over DAT1 rather than a
 * separate wake GPIO. SCLK/SDATA are unclaimed here - so far unidentified,
 * possibly an unused debug/FM path on this board.
 */
/ {
	connectivity-combo {
		compatible = "mediatek,connectivity-combo";
		gpio_combo_rst_pin = <&pio 60 0>;
		gpio_combo_pmu_en_pin = <&pio 65 0>;
	};
};
