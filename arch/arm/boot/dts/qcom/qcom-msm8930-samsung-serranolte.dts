			vdda-supply = <&pm8921_l2>;
			// iommus = <...>;
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				/* port@0 {
					reg = <0>;
					csiphy0_ep: endpoint {
						clock-lanes = <1>;
