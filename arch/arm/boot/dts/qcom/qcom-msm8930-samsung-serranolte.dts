				<&mmcc VFE_CSI_CLK>,
				<&mmcc VFE_AHB_CLK>,
				<&mmcc VFE_AXI_CLK>;

			clock-names = "csi_ahb",
				"csi0", "csi0_phy",
				"csi1", "csi1_phy",
