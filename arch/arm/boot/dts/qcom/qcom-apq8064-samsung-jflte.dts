&gsbi6 {
	status = "okay";
	qcom,mode = <GSBI_PROT_I2C_UART>;
};

&gsbi6_serial {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&gsbi6_uart_4pins>;
};

&gsbi7 {
	status = "okay";
	qcom,mode = <GSBI_PROT_I2C_UART>;
};

&gsbi7_serial {
	status = "okay";
};


/* OTG */
&usb1 {
	status = "okay";
	dr_mode = "otg";
	ulpi {
		phy {
			v3p3-supply = <&pmic_l3>;
// DRMS operation not allowed

			v1p8-supply = <&pmic_l4>;
		};
	};
};

/* eMMC */
&sdcc1 {
	status = "okay";
	vmmc-supply = <&pmic_l5>;
	vqmmc-supply = <&pmic_s4>;
};

