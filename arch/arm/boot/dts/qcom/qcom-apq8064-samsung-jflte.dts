	// 	// 	stride = <(1920 * 3)>;
	// 	// 	format = "r8g8b8";
	// 	// };
	// };
	
	    lcd_gpio_supply: gpio-regulator {
	      compatible = "regulator-gpio";

	      regulator-name = "lcd-1.8v-gpio-supply";
	      regulator-min-microvolt = <1800000>;
	      regulator-max-microvolt = <1800000>;
	      regulator-boot-on;

	      gpios = <&pmic_gpio 4 GPIO_ACTIVE_HIGH>;// LCD_1.8V_EN
		gpios-states = <1>;
		states = <0000000 0>, <1800000 1>;

	      startup-delay-us = <100000>;
	      enable-active-high;
	    };

