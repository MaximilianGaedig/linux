#include <dt-bindings/leds/common.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>

/ {
	model = "Samsung Galaxy S4";
	compatible = "samsung,jflte", "qcom,apq8064";

	aliases {
		serial0 = &gsbi7_serial;
		serial1 = &gsbi6_serial;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	soc {
		rpm@108000 {
			regulators {
				vdd_l1_l2_l12_l18-supply = <&pmic_s4>;

				vin_lvs1_3_6-supply = <&pmic_s4>;
				vin_lvs4_5_7-supply = <&pmic_s4>;


				vdd_l24-supply = <&pmic_s1>;
				vdd_l25-supply = <&pmic_s1>;
				vin_lvs2-supply = <&pmic_s1>;

				vdd_l26-supply = <&pmic_s7>;
				vdd_l27-supply = <&pmic_s7>;
				vdd_l28-supply = <&pmic_s7>;

				vdd_ncp-supply = <&pmic_l6>;
