#include "qcom-apq8064-v2.0.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>

/ {
	model = "Samsung Galaxy S4";
	compatible = "samsung,jflte", "qcom,apq8064";

	aliases {
		serial0 = &gsbi7_serial;
		serial1 = &gsbi6_serial;

		// display0 = &framebuffer0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};


	// chosen {
	// 	#address-cells = <1>;
	// 	#size-cells = <1>;
	// 	ranges;
	//
	// 	stdout-path = "display0";
	//
	// 	// framebuffer0: framebuffer@3200000 {
	// 	// 	compatible = "simple-framebuffer";
	// 	// 	reg = <0x03200000 0x800000>;
	// 	// 	width = <1920>;
	// 	// 	height = <1080>;
	// 	// 	stride = <(1920 * 3)>;
	// 	// 	format = "r8g8b8";
	// 	// };
	// };
	
	// leds {
	// 	compatible = "gpio-leds";
	// 	pinctrl-names = "default";
	// 	pinctrl-0 = <&notify_led>;
	//
	// 	led-user {
	// 		label = "user0";
	// 		color = <LED_COLOR_ID_GREEN>;
	// 		gpios = <&pm8921_gpio 18 GPIO_ACTIVE_HIGH>;
	// 		default-state = "on";
	// 	};
	// };

	// reserved-memory {
	// 	#address-cells = <1>;
	// 	#size-cells = <1>;
	// 	ranges;
	//
	// 	framebuffer@3200000 {
	// 		reg = <0x03200000 0x800000>;
	// 		no-map;
	// 	};
	//
	// };

	// reserved-memory {
	// 	#address-cells = <1>;
	// 	#size-cells = <1>;
	// 	ranges;
	//
	// 	ramoops@88d00000{
	// 		compatible = "ramoops";
	// 		reg = <0x88d00000 0x100000>;
	// 		record-size     = <0x00020000>;
	// 		console-size    = <0x00020000>;
	// 		ftrace-size     = <0x00020000>;
	// 	};
	// };

	soc {
		rpm@108000 {
			regulators {
				vdd_l1_l2_l12_l18-supply = <&pm8921_s4>;
				vin_lvs1_3_6-supply = <&pm8921_s4>;
				vin_lvs4_5_7-supply = <&pm8921_s4>;


				vdd_l24-supply = <&pm8921_s1>;
				vdd_l25-supply = <&pm8921_s1>;
				vin_lvs2-supply = <&pm8921_s1>;

				vdd_l26-supply = <&pm8921_s7>;
				vdd_l27-supply = <&pm8921_s7>;
				vdd_l28-supply = <&pm8921_s7>;

				vdd_ncp-supply = <&pm8921_l6>;

				/* Buck SMPS */
				s1 {
					regulator-always-on;
					regulator-min-microvolt = <1300000>;
					regulator-max-microvolt = <1300000>;
					qcom,switch-mode-frequency = <3200000>;
					bias-pull-down;
				};

				/* wcnss_wlan.0-iris_vddrfa */
				s2 {
					regulator-min-microvolt = <1300000>;
					regulator-max-microvolt = <1300000>;
					qcom,switch-mode-frequency = <1600000>;
				};

				/*
				 * msm otg HSUSB_VDDCX
				 * wcnss_wlan.0-riva_vddcx
				 */
				s3 {
					regulator-min-microvolt = <500000>;
					regulator-max-microvolt = <1150000>;
					qcom,switch-mode-frequency = <4800000>;
				};

				/*
				 * msm_sdcc.1-sdc-vdd_io
				 * tabla2x-slim-CDC_VDDA_RX
				 * tabla2x-slim-CDC_VDDA_TX
				 * tabla2x-slim-CDC_VDD_CP
				 * tabla2x-slim-VDDIO_CDC
				 * wcnss_wlan.0-riva_vddpx
				 */
				s4 {
					regulator-min-microvolt	= <1800000>;
					regulator-max-microvolt	= <1800000>;
					qcom,switch-mode-frequency = <3200000>;
					regulator-always-on;
				};

				s7 {
					regulator-min-microvolt = <1300000>;
					regulator-max-microvolt = <1300000>;
					qcom,switch-mode-frequency = <3200000>;
				};

				s8 {
					regulator-min-microvolt = <1200000>;
					regulator-max-microvolt = <1200000>;
					qcom,switch-mode-frequency = <1600000>;
				};

				/* mipi_dsi.1-dsi1_pll_vdda */
				l2 {
					regulator-min-microvolt = <1200000>;
					regulator-max-microvolt = <1200000>;
					regulator-always-on;
				};

				/* msm_otg-HSUSB_3p3 */
				l3 {
					regulator-min-microvolt = <3075000>;
					regulator-max-microvolt = <3075000>;
					bias-pull-down;
				};

				/*
				 * msm_otg-HSUSB_1p8
				 * wcnss_wlan.0-iris_vddxo
				 */
				l4 {
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
					bias-pull-down;
				};

				/* msm_sdcc.1-sdc_vdd */
				l5 {
					regulator-min-microvolt = <2950000>;
					regulator-max-microvolt = <2950000>;
					regulator-always-on;
					bias-pull-down;
				};

				l6 {
					regulator-min-microvolt = <2950000>;
					regulator-max-microvolt = <2950000>;
				};

				
				// won't hurt to allow it to go to lower voltages, but the downstream kernel says min:3300000, max:3300000
				/* wcnss_wlan.0-iris_vddpa */
				l10 {
					regulator-min-microvolt = <2900000>;
					regulator-max-microvolt = <3300000>;
				};

				// ok
				/* mipi_dsi.1-dsi1_avdd */
				l11 {
					regulator-min-microvolt = <3300000>;
					regulator-max-microvolt = <3300000>;
					bias-pull-down;
					regulator-always-on;
				};

				/* pwm_power for backlight */ // there is no backlight?
				l17 {
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
					regulator-always-on;
				};

				// ok
				/* camera, qdsp6 */
				l23 {
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
					bias-pull-down;
				};

				/* wcnss_wlan.0-riva_vddmx */
				l24 {
					regulator-min-microvolt = <750000>;
					regulator-max-microvolt = <1150000>;
				};

				/*
				 * tabla2x-slim-CDC_VDDA_A_1P2V
				 * tabla2x-slim-VDDD_CDC_D
				 */
				l25 {
					regulator-min-microvolt = <1250000>;
					regulator-max-microvolt = <1250000>;
					bias-pull-down;
				};


				/* lcd 3.0V */
				l30 {
					regulator-min-microvolt = <3000000>;
					regulator-max-microvolt = <3000000>;
					bias-pull-down;
				};


				/* wcnss_wlan.0-iris_vddio */
				lvs1 {
					bias-pull-down;
				};

				/* wcnss_wlan.0-iris_vdddig */
				lvs2 {
				};

				lvs4 {
					bias-pull-down;
				};

				lvs5 {
					bias-pull-down;
				};

				lvs6 {
					bias-pull-down;
				};
				/*
				 * mipi_dsi.1-dsi1_vddio
				 * pil_riva-pll_vdd
				 */
				lvs7 {
					bias-pull-down;
					regulator-always-on;
				};

				ncp {
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
					qcom,switch-mode-frequency = <1600000>;
				};
			};
		};
	};
};

&mdp {
	status = "okay";
};

&mdp_dsi1_out {
    remote-endpoint = <&dsi0_in>;
};


&dsi0 {
	status = "okay";
        #address-cells = <1>;
        #size-cells = <0>;

	panel@0 {
	    compatible = "samsung,s6e8fa0";
	    reg = <0>;

	    vdd3-supply = <&pm8921_l16>;  //TSP_VDD_3.0V
	    vci-supply = <&pm8921_l30>; // VCC_3.0V_LCD (LDO)

	    enable-gpios = <&pm8921_gpio 4 GPIO_ACTIVE_HIGH>; // LCD_1.8V_EN
	    reset-gpios = <&pm8921_mpps 2 GPIO_ACTIVE_LOW>; // MLCD_RST

	   port {
		    panel_in: endpoint {
				remote-endpoint = <&dsi0_out>;
		    };
		};
	   };

};


&dsi0_in {
    remote-endpoint = <&mdp_dsi1_out>;
};

&dsi0_out {
    remote-endpoint = <&panel_in>;
    data-lanes = <0 1 2 3>;
};

&dsi0_phy {
	status = "okay";
};

&gsbi6 {
	status = "okay";
	qcom,mode = <GSBI_PROT_I2C_UART>;
};

&gsbi6_serial {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&gsbi6_uart_4pins>;
};

&gsbi7 {
	status = "okay";
	qcom,mode = <GSBI_PROT_I2C_UART>;
};

&gsbi7_serial {
	status = "okay";
};

/* OTG */
&usb1 {
	status = "okay";
	dr_mode = "otg";
	ulpi {
		phy {
			v3p3-supply = <&pm8921_l3>;
			v1p8-supply = <&pm8921_l4>;
		};
	};
};

/* eMMC */
&sdcc1 {
	status = "okay";
	vmmc-supply = <&pm8921_l5>;
	vqmmc-supply = <&pm8921_s4>;
};
