	// 	ramoops@88d00000{
	// 		compatible = "ramoops";
	// 		reg = <0x88d00000 0x100000>;
	// 		record-size     = <0x00020000>;
	// 		console-size    = <0x00020000>;
	// 		ftrace-size     = <0x00020000>;
	// 	};
	// };

};



&mdp {
	status = "okay";
};

&mdp_dsi1_out {
    remote-endpoint = <&dsi0_in>;
};


&dsi0 {
	status = "okay";
        #address-cells = <1>;
        #size-cells = <0>;

// 		[  831.184443] data->n_resources: 178, resource: 162
// [  831.184805] Failed to enable vci: -EIO
	panel@0 {
	    compatible = "samsung,s6e8fa0";
	    reg = <0>;

	    vdd3-supply = <&pmic_l16>;  // TSP_VDD_3.0V
	    // vdd3-supply = <&pmic_l30>; // VCC_3.0V_LCD (LDO)
	    
// this needs to be l30, otherwise the display turns off after the linux kernel gets control in the boot process 
// l31 works too for some reason????!!!!!!!!!!!!!!!!???????
	    vci-supply = <&pmic_l30>; // VCC_3.0V_LCD (LDO)

	    reset-gpios = <&pmic_mpps 2 GPIO_ACTIVE_HIGH>; // MLCD_RST

	power-on-delay= <50>;
	reset-delay = <100>;
	init-delay = <100>;

	display-timings {
		// these values work, but might not be ideal, partly taken from https://github.com/rushup/rushup-linux-artik, partly from another 1080x1920 display in the kernel and hback-porch randomly set to 200 
		timing-0 {
			clock-frequency = <148500000>;
			hactive = <1080>;
			vactive = <1920>;


			hfront-porch = <160>;
			hback-porch = <200>;
			vfront-porch = <10>;
			vback-porch = <4>;

			hsync-len = <10>;
			vsync-len = <2>;
		};
	};

	   port {
		    panel_in: endpoint {
				remote-endpoint = <&dsi0_out>;
		    };
		};
	   };

};


&dsi0_in {
    remote-endpoint = <&mdp_dsi1_out>;
};

&dsi0_out {
    remote-endpoint = <&panel_in>;
    data-lanes = <0 1 2 3>;
};

&dsi0_phy {
	status = "okay";
};

&gsbi6 {
	status = "okay";
	qcom,mode = <GSBI_PROT_I2C_UART>;
};

&gsbi6_serial {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&gsbi6_uart_4pins>;
};

&gsbi7 {
	status = "okay";
	qcom,mode = <GSBI_PROT_I2C_UART>;
};

&gsbi7_serial {
	status = "okay";
};


/* OTG */
&usb1 {
	status = "okay";
	dr_mode = "otg";
	ulpi {
		phy {
			v3p3-supply = <&pmic_l3>;
// DRMS operation not allowed

			v1p8-supply = <&pmic_l4>;
		};
	};
};

/* eMMC */
&sdcc1 {
	status = "okay";
	vmmc-supply = <&pmic_l5>;
	vqmmc-supply = <&pmic_s4>;
};

/* SD card */
&sdcc2 {
	status = "okay";
	vmmc-supply = <&pmic_l6>;

	pinctrl-names = "default";
	pinctrl-0 = <&pmic_gpio>;
	cd-gpios = <&pmic_gpio 33 GPIO_ACTIVE_HIGH>;
};

&tlmm_pinmux {
	i2c_led_pins: i2c_led_pins {
		mux {
			pins = "gpio6", "gpio7";
			function = "gpio";
		};
		conf {
			pins = "gpio6", "gpio7";
			drive-strength = <16>;
			bias-disable;
		};
	};

	i2c_touch_button_pins: i2c_touch_buttons_pins {
		mux {
			pins = "gpio26", "gpio33";
			function = "gpio";
		};
		conf {
			pins = "gpio26", "gpio33";
			drive-strength = <16>;
			bias-disable;
		};
	};


	touchscreen_pins: touchscreen_pins {
		mux {
			pins = "gpio67";
			function = "gpio";
		};
		conf {
			pins = "gpio67";
			drive-strength = <2>;
			bias-pull-up;
		};
	};
};

