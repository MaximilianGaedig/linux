#include "qcom-apq8064-pm8917.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>

/ {
	model = "Samsung Galaxy S4";
	compatible = "samsung,jflte", "qcom,apq8064";

	aliases {
		serial0 = &gsbi7_serial;
		serial1 = &gsbi6_serial;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	soc {
		rpm@108000 {
			regulators {
				vdd_l1_l2_l12_l18-supply = <&pmic_s4>;

				vin_lvs1_3_6-supply = <&pmic_s4>;
				vin_lvs4_5_7-supply = <&pmic_s4>;


				vdd_l24-supply = <&pmic_s1>;
				vdd_l25-supply = <&pmic_s1>;
				vin_lvs2-supply = <&pmic_s1>;

				vdd_l26-supply = <&pmic_s7>;
				vdd_l27-supply = <&pmic_s7>;
				vdd_l28-supply = <&pmic_s7>;

				vdd_ncp-supply = <&pmic_l6>;


				// device needs some definitions for sure, weird yellow pixel bug without

				/* Buck SMPS */
				s1 {
					regulator-always-on;
					regulator-min-microvolt = <1300000>;
					regulator-max-microvolt = <1300000>;
					qcom,switch-mode-frequency = <3200000>;
					bias-pull-down;
				};

				/* wcnss_wlan.0-iris_vddrfa */
				s2 {
					regulator-min-microvolt = <1300000>;
					regulator-max-microvolt = <1300000>;
					qcom,switch-mode-frequency = <1600000>;
				};

				/*
				 * msm otg HSUSB_VDDCX
				 * wcnss_wlan.0-riva_vddcx
				 */
				s3 {
					regulator-min-microvolt = <500000>;
					regulator-max-microvolt = <1150000>;
					qcom,switch-mode-frequency = <4800000>;
				};

				/*
				 * msm_sdcc.1-sdc-vdd_io
				 * tabla2x-slim-CDC_VDDA_RX
				 * tabla2x-slim-CDC_VDDA_TX
				 * tabla2x-slim-CDC_VDD_CP
				 * tabla2x-slim-VDDIO_CDC
				 * wcnss_wlan.0-riva_vddpx
				 */
				s4 {
					regulator-min-microvolt	= <1800000>;
					regulator-max-microvolt	= <1800000>;
					qcom,switch-mode-frequency = <3200000>;
					regulator-always-on;
				};

				s7 {
					regulator-min-microvolt = <1300000>;
					regulator-max-microvolt = <1300000>;
					qcom,switch-mode-frequency = <3200000>;
				};

				s8 {
					regulator-min-microvolt = <1200000>;
					regulator-max-microvolt = <1200000>;
					qcom,switch-mode-frequency = <1600000>;
				};

				/* mipi_dsi.1-dsi1_pll_vdda */
				l2 {
					regulator-min-microvolt = <1200000>;
					regulator-max-microvolt = <1200000>;
					regulator-always-on;
				};

				/* msm_otg-HSUSB_3p3 */
				l3 {
					regulator-min-microvolt = <3075000>;
					regulator-max-microvolt = <3075000>;
					bias-pull-down;
				};

				/*
				 * msm_otg-HSUSB_1p8
				 * wcnss_wlan.0-iris_vddxo
				 */
				l4 {
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
					bias-pull-down;
				};

				/* msm_sdcc.1-sdc_vdd */
				l5 {
					regulator-min-microvolt = <2950000>;
					regulator-max-microvolt = <2950000>;
					regulator-always-on;
					bias-pull-down;
				};

				l6 {
					regulator-min-microvolt = <2950000>;
					regulator-max-microvolt = <2950000>;
					regulator-always-on;
				};

				/* modem */
				l7 {
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
				};

				l8 {
					regulator-min-microvolt = <2800000>;
					regulator-max-microvolt = <2800000>;
				};

				l9 {
					regulator-min-microvolt = <2850000>;
					regulator-max-microvolt = <2850000>;
					regulator-always-on;
				};


				/* gesture sensor */
				l10 {
					regulator-min-microvolt = <2900000>;
					regulator-max-microvolt = <3300000>;
				};

				/* VTOUCH 3.3v */
				l11 {
					regulator-min-microvolt = <3300000>;
					regulator-max-microvolt = <3300000>;
					bias-pull-down;
					regulator-always-on;
				};

				// /* VDDA wlan */
				// l12 {
				// 	regulator-min-microvolt = <3300000>;
				// 	regulator-max-microvolt = <3300000>;
				// };

				// /* ??? */ // does not exist but lineage has it..
				// l13 {
				// 	regulator-min-microvolt = <2220000>;
				// 	regulator-max-microvolt = <2220000>;
				// };

				/* display connector */
				l14 {
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
					bias-pull-down;
					regulator-always-on;
				};

				l15 {
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <2950000>;
				};


				/* analog for touchscreen */
				l16 {
					regulator-min-microvolt = <2800000>;
					regulator-max-microvolt = <3000000>;
					regulator-always-on;
				};

				/* pwm_power for backlight */ // there is no backlight?
				l17 {
					regulator-min-microvolt = <3000000>;
					regulator-max-microvolt = <3000000>;
				};


				/* ambient mic? */
				l18 {
					regulator-min-microvolt = <1100000>;
					regulator-max-microvolt = <1100000>;
				};

				/* camera */
				l21 {
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
				};

				// ok
				/* touchscreen */
				l22 {
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
				};

				// ok
				/* touchkeys */
				l23 {
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
					bias-pull-down;
					regulator-always-on;
				};

				/* wcnss_wlan.0-riva_vddmx */
				l24 {
					regulator-min-microvolt = <750000>;
					regulator-max-microvolt = <1150000>;
				};

				/*
				 * tabla2x-slim-CDC_VDDA_A_1P2V
				 * tabla2x-slim-VDDD_CDC_D
				 */
				l25 {
					regulator-min-microvolt = <1250000>;
					regulator-max-microvolt = <1250000>;
					bias-pull-down;
				};

				/* pil_qdsp6v4.0-core_vdd */
				l26 {
				    regulator-min-microvolt = <375000>;
				    regulator-max-microvolt = <1050000>;
				};

				/* no description provided */
				l27 {
				    regulator-min-microvolt = <1100000>;
				    regulator-max-microvolt = <1100000>;
				};

				/* no description provided */
				l28 {
				    regulator-min-microvolt = <1100000>;
				    regulator-max-microvolt = <1100000>;
				};

				/* no description provided */
				l29 {
				    regulator-min-microvolt = <1800000>;
				    regulator-max-microvolt = <1800000>;
				};


				// this definition does not matter at all at the moment, propably because the default voltage is 3V
				// EINVAL
				/* mipi_dsi.1-3000mV_LCD */
				l30 {
				    regulator-min-microvolt = <3000000>;
				    regulator-max-microvolt = <3000000>;
				    // bias-pull-down;
				};

				/* no description provided */
				l31 {
				    regulator-min-microvolt = <1800000>;
				    regulator-max-microvolt = <1800000>;
				};

				/* no description provided */
				l32 {
				    regulator-min-microvolt = <3300000>;
				    regulator-max-microvolt = <3300000>;
				};

				/* FPGA */
				l33 {
				    regulator-min-microvolt = <1200000>;
				    regulator-max-microvolt = <1200000>;
				    regulator-always-on;
				};

				/* tabla2x-slim-CDC_VDDA_RX, tabla2x-slim-CDC_VDDA_TX */
				l34 {
				    regulator-min-microvolt = <2200000>;
				    regulator-max-microvolt = <2200000>;
				};

				/* no description provided */
				l35 {
				    regulator-min-microvolt = <1800000>;
				    regulator-max-microvolt = <1800000>;
				};

				/* no description provided */
				l36 {
				    regulator-min-microvolt = <1800000>;
				    regulator-max-microvolt = <1800000>;
				};


				/* wcnss_wlan.0-iris_vddio */
				lvs1 {
					bias-pull-down;
				};

				/* wcnss_wlan.0-iris_vdddig */
				lvs2 {
				};

				lvs4 {
					bias-pull-down;
				};

				lvs5 {
					bias-pull-down;
				};

				lvs6 {
					bias-pull-down;
				};
				/*
				 * mipi_dsi.1-dsi1_vddio
				 * pil_riva-pll_vdd
				 */
				lvs7 {
					bias-pull-down;
					regulator-always-on;
				};

				// ncp {
				// 	regulator-min-microvolt = <1800000>;
				// 	regulator-max-microvolt = <1800000>;
				// 	qcom,switch-mode-frequency = <1600000>;
				// };
			};
		};
	};

	i2c-gpio-led {
		compatible = "i2c-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		scl-gpios = <&tlmm_pinmux 7 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		sda-gpios = <&tlmm_pinmux 6 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c_led_pins>;

		i2c-gpio,delay-us = <2>;

		led-controller@30 {
			compatible = "panasonic,an30259a";
			reg = <0x30>;

			#address-cells = <1>;
			#size-cells = <0>;

			led@1 {
				label = "status-led:red";
				linux,default-trigger = "heartbeat";
				reg = <1>;
				function = LED_FUNCTION_STATUS;
				color = <LED_COLOR_ID_RED>;
			};

			led@2 {
				label = "status-led:green";
				linux,default-trigger = "cpu0";
				reg = <2>;
				function = LED_FUNCTION_STATUS;
				color = <LED_COLOR_ID_GREEN>;
			};

			led@3 {
				label = "status-led:blue";
				linux,default-trigger = "default-on";
				reg = <3>;
				function = LED_FUNCTION_STATUS;
				color = <LED_COLOR_ID_BLUE>;
			};
		};
	};

	i2c-gpio-touch-buttons {
		compatible = "i2c-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		scl-gpios = <&tlmm_pinmux 26 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		sda-gpios = <&tlmm_pinmux 33 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c_touch_button_pins>;

		i2c-gpio,delay-us = <2>;


		// found but not working
		touchkeys@20 {
		    compatible = "coreriver,tc360-touchkey";
		    reg = <0x20>;
		    interrupt-parent = <&tlmm_pinmux>;
		    interrupts = <31 IRQ_TYPE_EDGE_FALLING>;

	// touchkey->regulators[0].supply = "vcc";
	// touchkey->regulators[1].supply = "vdd";
	// touchkey->regulators[2].supply = "vddio";
			vdd-supply = <&pmic_l11>;
			vcc-supply = <&pmic_l23>;
			vddio-supply = <&lcd_gpio_supply>;

			// vddio-supply = <&pmic_l16>; //?

		    linux,keycodes = <KEY_MENU KEY_BACK>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		volume-up {
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pmic_gpio 35 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		};

		volume-down {
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&pmic_gpio 37 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		};

		// doesn't work
		home {
			linux,code = <KEY_HOME>;
			gpios = <&pmic_gpio 30 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};
	};


	spi-gpio-fpga {
		compatible = "spi-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_mpps>;

		sck-gpios = <&pmic_mpps 9 GPIO_ACTIVE_HIGH>;
		mosi-gpios = <&pmic_mpps 10 GPIO_ACTIVE_HIGH>;

		i2c-gpio,delay-us = <2>;


		fpga: fpga@0 {
			compatible = "lattice,ice40-fpga-mgr";
			reg = <0>;
			spi-max-frequency = <5000000>;
			cdone-gpios = <&tlmm_pinmux 38 GPIO_ACTIVE_HIGH>;
			reset-gpios = <&pmic_gpio 9 GPIO_ACTIVE_LOW>;
		};
	};
	// i2c_max77693_fuel: i2c-gpio-3 {
	// 	compatible = "i2c-gpio";
	// 	sda-gpios = <&gpf1 5 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	// 	scl-gpios = <&gpf1 4 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	// 	i2c-gpio,delay-us = <2>;
	// 	#address-cells = <1>;
	// 	#size-cells = <0>;
	//
	// 	fuel-gauge@36 {
	// 		compatible = "maxim,max17047";
	// 		interrupt-parent = <&gpx2>;
	// 		interrupts = <3 IRQ_TYPE_LEVEL_LOW>;
	// 		pinctrl-names = "default";
	// 		pinctrl-0 = <&max77693_fuel_irq>;
	// 		reg = <0x36>;
	//
	// 		maxim,over-heat-temp = <700>;
	// 		maxim,over-volt = <4500>;
	// 	};
