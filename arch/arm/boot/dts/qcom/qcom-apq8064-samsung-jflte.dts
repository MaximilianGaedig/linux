// &wcnss_iris {
// 	compatible = "qcom,wcn3660b";
// };

		// L11 - VTOUCH_3.3V		- touchkeys
		// L16 - TSP_VDD_3.0V		- 
		// L17 - TSP_AVDD_3.3V		- 
		// L22 - TSP_VDD_1.8V           - touch screen
		// L23 - VTOUCH_1.8V		- touchkeys
		// L30 - VCC_3.0V_LCD (LDO)     - display

&gsbi3 {
	status = "okay";
	qcom,mode = <GSBI_PROT_I2C>;
};

&gsbi3_i2c {
	status = "okay";
	clock-frequency = <200000>;

	// detected, but not working
	touchscreen@20 {
		compatible = "syna,rmi4-i2c";
		reg = <0x20>;

		syna,startup-delay-ms = <1000>;
		interrupts-extended = <&tlmm_pinmux 67 IRQ_TYPE_EDGE_FALLING>;

		vdd-supply = <&pmic_l17>;
		vio-supply = <&pmic_l22>;


		pinctrl-names = "default";
		pinctrl-0 = <&touchscreen_pins>;

		#address-cells = <1>;
		#size-cells = <0>;

		rmi4-f01@1 {
			reg = <0x1>;
			syna,nosleep-mode = <1>;
		};



		rmi4-f11@11 {
			reg = <0x12>;
			syna,sensor-type = <1>;

			/*
			 * Touchscreen size is 2040x1080, y-values between
			 * 1920-2040 are used for touchkey (menu, home & back).
			 * For now clip it off so we don't get touch events
			 * outside of the display area.
			 */
			// syna,clip-y-high = <1920>;
		};

	};


};


