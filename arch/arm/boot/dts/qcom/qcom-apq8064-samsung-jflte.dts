				// device needs some definitions for sure, weird yellow pixel bug without

				/* Buck SMPS */
				s1 {
					regulator-always-on;
					regulator-min-microvolt = <1300000>;
					regulator-max-microvolt = <1300000>;
					qcom,switch-mode-frequency = <3200000>;
					bias-pull-down;
				};

				/* wcnss_wlan.0-iris_vddrfa */
				s2 {
					regulator-min-microvolt = <1300000>;
					regulator-max-microvolt = <1300000>;
					qcom,switch-mode-frequency = <1600000>;
				};

				/*
				 * msm otg HSUSB_VDDCX
				 * wcnss_wlan.0-riva_vddcx
				 */
				s3 {
					regulator-min-microvolt = <500000>;
					regulator-max-microvolt = <1150000>;
					qcom,switch-mode-frequency = <4800000>;
				};

				/*
				 * msm_sdcc.1-sdc-vdd_io
				 * tabla2x-slim-CDC_VDDA_RX
				 * tabla2x-slim-CDC_VDDA_TX
				 * tabla2x-slim-CDC_VDD_CP
				 * tabla2x-slim-VDDIO_CDC
				 * wcnss_wlan.0-riva_vddpx
				 */
				s4 {
					regulator-min-microvolt	= <1800000>;
					regulator-max-microvolt	= <1800000>;
					qcom,switch-mode-frequency = <3200000>;
					regulator-always-on;
				};

				s7 {
					regulator-min-microvolt = <1300000>;
					regulator-max-microvolt = <1300000>;
					qcom,switch-mode-frequency = <3200000>;
				};

				s8 {
					regulator-min-microvolt = <1200000>;
					regulator-max-microvolt = <1200000>;
					qcom,switch-mode-frequency = <1600000>;
				};

				/* mipi_dsi.1-dsi1_pll_vdda */
				l2 {
					regulator-min-microvolt = <1200000>;
					regulator-max-microvolt = <1200000>;
					regulator-always-on;
				};

				/* msm_otg-HSUSB_3p3 */
				l3 {
					regulator-min-microvolt = <3075000>;
					regulator-max-microvolt = <3075000>;
					bias-pull-down;
				};

				/*
				 * msm_otg-HSUSB_1p8
				 * wcnss_wlan.0-iris_vddxo
				 */
				l4 {
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
					bias-pull-down;
				};

				/* msm_sdcc.1-sdc_vdd */
				l5 {
					regulator-min-microvolt = <2950000>;
					regulator-max-microvolt = <2950000>;
					regulator-always-on;
					bias-pull-down;
				};

				l6 {
					regulator-min-microvolt = <2950000>;
					regulator-max-microvolt = <2950000>;
					regulator-always-on;
				};

				/* modem */
				l7 {
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
				};

				l8 {
					regulator-min-microvolt = <2800000>;
					regulator-max-microvolt = <2800000>;
				};

				l9 {
					regulator-min-microvolt = <2850000>;
					regulator-max-microvolt = <2850000>;
					regulator-always-on;
				};


				/* gesture sensor */
				l10 {
					regulator-min-microvolt = <2900000>;
					regulator-max-microvolt = <3300000>;
				};

				/* VTOUCH 3.3v */
				l11 {
					regulator-min-microvolt = <3300000>;
					regulator-max-microvolt = <3300000>;
					bias-pull-down;
					regulator-always-on;
				};

				// /* VDDA wlan */
				// l12 {
				// 	regulator-min-microvolt = <3300000>;
				// 	regulator-max-microvolt = <3300000>;
				// };

				// /* ??? */ // does not exist but lineage has it..
				// l13 {
				// 	regulator-min-microvolt = <2220000>;
				// 	regulator-max-microvolt = <2220000>;
				// };

				/* display connector */
				l14 {
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
					bias-pull-down;
					regulator-always-on;
				};

				l15 {
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <2950000>;
				};


				/* analog for touchscreen */
				l16 {
					regulator-min-microvolt = <2800000>;
					regulator-max-microvolt = <3000000>;
					regulator-always-on;
				};

				/* pwm_power for backlight */ // there is no backlight?
				l17 {
					regulator-min-microvolt = <3000000>;
					regulator-max-microvolt = <3000000>;
				};


				/* ambient mic? */
				l18 {
					regulator-min-microvolt = <1100000>;
					regulator-max-microvolt = <1100000>;
				};

				/* camera */
				l21 {
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
				};

				// ok
				/* touchscreen */
				l22 {
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
				};

				// ok
				/* touchkeys */
				l23 {
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
					bias-pull-down;
					regulator-always-on;
				};

				/* wcnss_wlan.0-riva_vddmx */
				l24 {
					regulator-min-microvolt = <750000>;
					regulator-max-microvolt = <1150000>;
				};

				/*
				 * tabla2x-slim-CDC_VDDA_A_1P2V
				 * tabla2x-slim-VDDD_CDC_D
				 */
				l25 {
					regulator-min-microvolt = <1250000>;
					regulator-max-microvolt = <1250000>;
					bias-pull-down;
				};

				/* pil_qdsp6v4.0-core_vdd */
				l26 {
				    regulator-min-microvolt = <375000>;
				    regulator-max-microvolt = <1050000>;
				};

				/* no description provided */
				l27 {
				    regulator-min-microvolt = <1100000>;
				    regulator-max-microvolt = <1100000>;
				};

				/* no description provided */
				l28 {
				    regulator-min-microvolt = <1100000>;
				    regulator-max-microvolt = <1100000>;
				};

				/* no description provided */
				l29 {
				    regulator-min-microvolt = <1800000>;
				    regulator-max-microvolt = <1800000>;
				};


				// this definition does not matter at all at the moment, propably because the default voltage is 3V
				// EINVAL
				/* mipi_dsi.1-3000mV_LCD */
				l30 {
				    regulator-min-microvolt = <3000000>;
				    regulator-max-microvolt = <3000000>;
				    // bias-pull-down;
				};

				/* no description provided */
				l31 {
				    regulator-min-microvolt = <1800000>;
				    regulator-max-microvolt = <1800000>;
				};

				/* no description provided */
				l32 {
				    regulator-min-microvolt = <3300000>;
				    regulator-max-microvolt = <3300000>;
				};

				/* FPGA */
				l33 {
				    regulator-min-microvolt = <1200000>;
				    regulator-max-microvolt = <1200000>;
				    regulator-always-on;
				};

				/* tabla2x-slim-CDC_VDDA_RX, tabla2x-slim-CDC_VDDA_TX */
				l34 {
				    regulator-min-microvolt = <2200000>;
				    regulator-max-microvolt = <2200000>;
				};

				/* no description provided */
				l35 {
				    regulator-min-microvolt = <1800000>;
				    regulator-max-microvolt = <1800000>;
				};

				/* no description provided */
				l36 {
				    regulator-min-microvolt = <1800000>;
				    regulator-max-microvolt = <1800000>;
				};


				/* wcnss_wlan.0-iris_vddio */
				lvs1 {
					bias-pull-down;
				};

				/* wcnss_wlan.0-iris_vdddig */
				lvs2 {
				};

				lvs4 {
					bias-pull-down;
				};

				lvs5 {
					bias-pull-down;
				};

				lvs6 {
					bias-pull-down;
				};
				/*
				 * mipi_dsi.1-dsi1_vddio
				 * pil_riva-pll_vdd
				 */
				lvs7 {
					bias-pull-down;
					regulator-always-on;
				};

				// ncp {
				// 	regulator-min-microvolt = <1800000>;
				// 	regulator-max-microvolt = <1800000>;
				// 	qcom,switch-mode-frequency = <1600000>;
				// };
			};
		};
	};

